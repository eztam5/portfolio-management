<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-instruments" author="codex">
        <createTable tableName="instruments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_instruments" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="symbol" type="VARCHAR(64)" />
            <column name="isin" type="VARCHAR(12)" />
            <column name="latest" type="DECIMAL(19,4)" />
            <column name="currency" type="VARCHAR(3)" />
        </createTable>
        <addUniqueConstraint tableName="instruments"
                             columnNames="isin"
                             constraintName="uk_instruments_isin" />
    </changeSet>

    <changeSet id="002-create-instrument-lists" author="codex">
        <createTable tableName="instrument_lists">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_instrument_lists" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint tableName="instrument_lists"
                             columnNames="name"
                             constraintName="uk_instrument_lists_name" />
    </changeSet>

    <changeSet id="003-create-instrument-list-instruments" author="codex">
        <createTable tableName="instrument_list_instruments">
            <column name="instrument_list_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="instrument_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addPrimaryKey tableName="instrument_list_instruments"
                       columnNames="instrument_list_id, instrument_id"
                       constraintName="pk_instrument_list_instruments" />
        <addForeignKeyConstraint baseTableName="instrument_list_instruments"
                                 baseColumnNames="instrument_list_id"
                                 constraintName="fk_list_instruments_list"
                                 referencedTableName="instrument_lists"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE" />
        <addForeignKeyConstraint baseTableName="instrument_list_instruments"
                                 baseColumnNames="instrument_id"
                                 constraintName="fk_list_instruments_instrument"
                                 referencedTableName="instruments"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE" />
    </changeSet>

    <changeSet id="004-create-instrument-prices" author="codex">
        <createTable tableName="instrument_prices">
            <column name="instrument_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="price_date" type="DATE">
                <constraints nullable="false" />
            </column>
            <column name="open_price" type="DECIMAL(19,6)" />
            <column name="high_price" type="DECIMAL(19,6)" />
            <column name="low_price" type="DECIMAL(19,6)" />
            <column name="close_price" type="DECIMAL(19,6)">
                <constraints nullable="false" />
            </column>
            <column name="adjusted_close_price" type="DECIMAL(19,6)" />
            <column name="volume" type="BIGINT" />
            <column name="currency" type="VARCHAR(3)" />
        </createTable>
        <addPrimaryKey tableName="instrument_prices"
                       columnNames="instrument_id, price_date"
                       constraintName="pk_instrument_prices" />
        <addForeignKeyConstraint baseTableName="instrument_prices"
                                 baseColumnNames="instrument_id"
                                 constraintName="fk_instrument_prices_instrument"
                                 referencedTableName="instruments"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE" />
        <createIndex tableName="instrument_prices" indexName="idx_instrument_prices_date">
            <column name="price_date" />
        </createIndex>
    </changeSet>

    <changeSet id="005-create-cash-accounts" author="codex">
        <createTable tableName="cash_accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_cash_accounts" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false" />
            </column>
            <column name="balance" type="DECIMAL(19,4)">
                <constraints nullable="false" />
            </column>
            <column name="note" type="VARCHAR(2000)" />
        </createTable>
        <addUniqueConstraint tableName="cash_accounts"
                             columnNames="name"
                             constraintName="uk_cash_accounts_name" />
    </changeSet>

    <changeSet id="006-create-security-accounts" author="codex">
        <createTable tableName="security_accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_security_accounts" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="note" type="VARCHAR(2000)" />
        </createTable>
        <addUniqueConstraint tableName="security_accounts"
                             columnNames="name"
                             constraintName="uk_security_accounts_name" />
    </changeSet>

    <changeSet id="007-create-transactions" author="codex">
        <createTable tableName="transactions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_transactions" />
            </column>
            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false" />
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false" />
            </column>
            <column name="cash_account_id" type="BIGINT" />
            <column name="target_cash_account_id" type="BIGINT" />
            <column name="security_account_id" type="BIGINT" />
            <column name="instrument_id" type="BIGINT" />
            <column name="shares" type="DECIMAL(19,8)" />
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="false" />
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false" />
            </column>
            <column name="gross_amount" type="DECIMAL(19,4)" />
            <column name="gross_amount_currency" type="VARCHAR(3)" />
            <column name="exchange_rate" type="DECIMAL(19,8)" />
            <column name="fees" type="DECIMAL(19,4)" />
            <column name="taxes" type="DECIMAL(19,4)" />
            <column name="note" type="VARCHAR(2000)" />
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="transactions"
                                 baseColumnNames="cash_account_id"
                                 constraintName="fk_transactions_cash_account"
                                 referencedTableName="cash_accounts"
                                 referencedColumnNames="id" />
        <addForeignKeyConstraint baseTableName="transactions"
                                 baseColumnNames="target_cash_account_id"
                                 constraintName="fk_transactions_target_cash_account"
                                 referencedTableName="cash_accounts"
                                 referencedColumnNames="id" />
        <addForeignKeyConstraint baseTableName="transactions"
                                 baseColumnNames="security_account_id"
                                 constraintName="fk_transactions_security_account"
                                 referencedTableName="security_accounts"
                                 referencedColumnNames="id" />
        <addForeignKeyConstraint baseTableName="transactions"
                                 baseColumnNames="instrument_id"
                                 constraintName="fk_transactions_instrument"
                                 referencedTableName="instruments"
                                 referencedColumnNames="id" />
        <createIndex tableName="transactions" indexName="idx_transactions_date">
            <column name="transaction_date" />
        </createIndex>
        <createIndex tableName="transactions" indexName="idx_transactions_cash_account">
            <column name="cash_account_id" />
        </createIndex>
        <createIndex tableName="transactions" indexName="idx_transactions_instrument">
            <column name="instrument_id" />
        </createIndex>
    </changeSet>

    <changeSet id="008-drop-cash-account-balance" author="codex">
        <dropColumn tableName="cash_accounts" columnName="balance" />
    </changeSet>
</databaseChangeLog>
