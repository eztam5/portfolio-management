<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane fx:id="mainSplitPane"
           dividerPositions="0.22"
           maxHeight="Infinity"
           maxWidth="Infinity"
           minHeight="420.0"
           minWidth="760.0"
           prefHeight="640.0"
           prefWidth="1040.0"
           stylesheets="@MainWindowView.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.portfoliomanagement.MainWindowController">
    <items>
        <VBox fx:id="menuBar"
              minWidth="160.0"
              prefWidth="220.0"
              styleClass="side-menu"
              SplitPane.resizableWithParent="false">
            <children>
                <Label styleClass="app-title" text="Portfolio" />
                <VBox styleClass="menu-section">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="menu-section-header-row">
                            <children>
                                <Label maxWidth="Infinity" styleClass="menu-section-header" text="Securities" HBox.hgrow="ALWAYS" />
                                <Button fx:id="addSecuritiesListButton"
                                        mnemonicParsing="false"
                                        onAction="#promptForSecuritiesListName"
                                        styleClass="section-add-button"
                                        text="+" />
                            </children>
                        </HBox>
                        <ToggleButton fx:id="allSecuritiesMenuItem"
                                      maxWidth="Infinity"
                                      mnemonicParsing="false"
                                      onAction="#showAllSecurities"
                                      styleClass="menu-entry"
                                      text="All Securities" />
                        <VBox fx:id="instrumentListsMenuItems" styleClass="menu-subsection" />
                    </children>
                </VBox>
                <VBox styleClass="menu-section">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="menu-section-header-row">
                            <children>
                                <Label maxWidth="Infinity" styleClass="menu-section-header" text="Accounts" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <ToggleButton fx:id="securityAccountsMenuItem"
                                      maxWidth="Infinity"
                                      mnemonicParsing="false"
                                      onAction="#showSecurityAccounts"
                                      styleClass="menu-entry"
                                      text="Security Accounts" />
                        <ToggleButton fx:id="cashAccountsMenuItem"
                                      maxWidth="Infinity"
                                      mnemonicParsing="false"
                                      onAction="#showCashAccounts"
                                      styleClass="menu-entry"
                                      text="Cash Accounts" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox minWidth="360.0" styleClass="content-pane" VBox.vgrow="ALWAYS">
            <children>
                <SplitPane fx:id="tableChartSplitPane"
                           dividerPositions="0.68"
                           orientation="VERTICAL"
                           styleClass="chart-split-pane"
                           VBox.vgrow="ALWAYS">
                    <items>
                        <VBox minHeight="220.0" styleClass="table-section">
                            <children>
                                <HBox alignment="CENTER_LEFT" styleClass="table-toolbar">
                                    <children>
                                        <Label fx:id="tableTitleLabel"
                                               maxWidth="Infinity"
                                               styleClass="table-title"
                                               text="All Securities"
                                               HBox.hgrow="ALWAYS" />
                                        <Button fx:id="addInstrumentButton"
                                                mnemonicParsing="false"
                                                onAction="#promptForInstrument"
                                                styleClass="table-add-button"
                                                text="+" />
                                    </children>
                                </HBox>
                                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                                    <children>
                                        <TableView fx:id="securitiesTable">
                                            <columns>
                                                <TableColumn fx:id="nameColumn" minWidth="160.0" prefWidth="240.0" text="Name" />
                                                <TableColumn fx:id="symbolColumn" minWidth="90.0" prefWidth="120.0" text="Symbol" />
                                                <TableColumn fx:id="isinColumn" minWidth="130.0" prefWidth="160.0" text="ISIN" />
                                                <TableColumn fx:id="latestColumn" minWidth="90.0" prefWidth="120.0" text="Latest" />
                                                <TableColumn fx:id="currencyColumn" minWidth="90.0" prefWidth="120.0" text="currency" />
                                            </columns>
                                            <placeholder>
                                                <Label text="No securities available." />
                                            </placeholder>
                                        </TableView>
                                        <TableView fx:id="securityAccountsTable">
                                            <columns>
                                                <TableColumn fx:id="securityAccountNameColumn" minWidth="180.0" prefWidth="280.0" text="Name" />
                                                <TableColumn fx:id="securityAccountNoteColumn" minWidth="220.0" prefWidth="520.0" text="Note" />
                                            </columns>
                                            <placeholder>
                                                <Label text="No security accounts available." />
                                            </placeholder>
                                        </TableView>
                                        <TableView fx:id="cashAccountsTable">
                                            <columns>
                                                <TableColumn fx:id="cashAccountNameColumn" minWidth="180.0" prefWidth="260.0" text="Name" />
                                                <TableColumn fx:id="cashAccountCurrencyColumn" minWidth="90.0" prefWidth="120.0" text="Currency" />
                                                <TableColumn fx:id="cashAccountBalanceColumn" minWidth="120.0" prefWidth="160.0" text="Balance" />
                                                <TableColumn fx:id="cashAccountNoteColumn" minWidth="220.0" prefWidth="420.0" text="Note" />
                                            </columns>
                                            <placeholder>
                                                <Label text="No cash accounts available." />
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>
                        <StackPane minHeight="150.0">
                            <children>
                                <VBox fx:id="chartDetailSection" styleClass="chart-section">
                                    <children>
                                        <Label fx:id="priceChartTitleLabel"
                                               maxWidth="Infinity"
                                               styleClass="chart-title-label"
                                               text="No security selected" />
                                        <TabPane styleClass="security-detail-tabs"
                                                 tabClosingPolicy="UNAVAILABLE"
                                                 VBox.vgrow="ALWAYS">
                                            <tabs>
                                                <Tab text="Chart">
                                                    <content>
                                                        <VBox styleClass="chart-tab-content">
                                                            <children>
                                                                <HBox fx:id="chartRangeButtons"
                                                                      alignment="CENTER_RIGHT"
                                                                      styleClass="chart-range-buttons" />
                                                                <LineChart fx:id="priceChart"
                                                                           animated="false"
                                                                           createSymbols="false"
                                                                           legendVisible="false"
                                                                           VBox.vgrow="ALWAYS">
                                                                    <xAxis>
                                                                        <NumberAxis side="BOTTOM" />
                                                                    </xAxis>
                                                                    <yAxis>
                                                                        <NumberAxis side="LEFT" />
                                                                    </yAxis>
                                                                    <padding>
                                                                        <Insets bottom="0.0" left="0.0" right="0.0" top="4.0" />
                                                                    </padding>
                                                                </LineChart>
                                                            </children>
                                                        </VBox>
                                                    </content>
                                                </Tab>
                                                <Tab text="Transactions">
                                                    <content>
                                                        <TableView fx:id="securityTransactionsTable"
                                                                   styleClass="transactions-table">
                                                            <columns>
                                                                <TableColumn fx:id="securityTransactionDateColumn" minWidth="90.0" prefWidth="110.0" text="Date" />
                                                                <TableColumn fx:id="securityTransactionTypeColumn" minWidth="90.0" prefWidth="110.0" text="Type" />
                                                                <TableColumn fx:id="securityTransactionSharesColumn" minWidth="90.0" prefWidth="120.0" text="Shares" />
                                                                <TableColumn fx:id="securityTransactionAmountColumn" minWidth="100.0" prefWidth="130.0" text="Amount" />
                                                                <TableColumn fx:id="securityTransactionCurrencyColumn" minWidth="80.0" prefWidth="100.0" text="Currency" />
                                                                <TableColumn fx:id="securityTransactionFeesColumn" minWidth="80.0" prefWidth="100.0" text="Fees" />
                                                                <TableColumn fx:id="securityTransactionTaxesColumn" minWidth="80.0" prefWidth="100.0" text="Taxes" />
                                                                <TableColumn fx:id="securityTransactionNoteColumn" minWidth="180.0" prefWidth="280.0" text="Note" />
                                                            </columns>
                                                            <placeholder>
                                                                <Label text="No transactions available." />
                                                            </placeholder>
                                                        </TableView>
                                                    </content>
                                                </Tab>
                                            </tabs>
                                        </TabPane>
                                    </children>
                                </VBox>
                                <VBox fx:id="accountDetailSection" styleClass="chart-section">
                                    <children>
                                        <Label fx:id="accountDetailTitleLabel"
                                               maxWidth="Infinity"
                                               styleClass="chart-title-label"
                                               text="No account selected" />
                                        <TabPane styleClass="security-detail-tabs"
                                                 tabClosingPolicy="UNAVAILABLE"
                                                 VBox.vgrow="ALWAYS">
                                            <tabs>
                                                <Tab text="Transactions">
                                                    <content>
                                                        <StackPane>
                                                            <children>
                                                                <TableView fx:id="securityAccountTransactionsTable"
                                                                           styleClass="transactions-table">
                                                                    <columns>
                                                                        <TableColumn fx:id="securityAccountTransactionDateColumn" minWidth="90.0" prefWidth="110.0" text="Date" />
                                                                        <TableColumn fx:id="securityAccountTransactionTypeColumn" minWidth="90.0" prefWidth="110.0" text="Type" />
                                                                        <TableColumn fx:id="securityAccountTransactionInstrumentColumn" minWidth="150.0" prefWidth="220.0" text="Instrument" />
                                                                        <TableColumn fx:id="securityAccountTransactionSharesColumn" minWidth="90.0" prefWidth="120.0" text="Shares" />
                                                                        <TableColumn fx:id="securityAccountTransactionAmountColumn" minWidth="100.0" prefWidth="130.0" text="Amount" />
                                                                        <TableColumn fx:id="securityAccountTransactionCurrencyColumn" minWidth="80.0" prefWidth="100.0" text="Currency" />
                                                                        <TableColumn fx:id="securityAccountTransactionCashAccountColumn" minWidth="140.0" prefWidth="180.0" text="Cash Account" />
                                                                        <TableColumn fx:id="securityAccountTransactionFeesColumn" minWidth="80.0" prefWidth="100.0" text="Fees" />
                                                                        <TableColumn fx:id="securityAccountTransactionTaxesColumn" minWidth="80.0" prefWidth="100.0" text="Taxes" />
                                                                        <TableColumn fx:id="securityAccountTransactionNoteColumn" minWidth="180.0" prefWidth="280.0" text="Note" />
                                                                    </columns>
                                                                    <placeholder>
                                                                        <Label text="No transactions available." />
                                                                    </placeholder>
                                                                </TableView>
                                                                <TableView fx:id="accountTransactionsTable"
                                                                           styleClass="transactions-table">
                                                                    <columns>
                                                                        <TableColumn fx:id="accountTransactionDateColumn" minWidth="90.0" prefWidth="110.0" text="Date" />
                                                                        <TableColumn fx:id="accountTransactionTypeColumn" minWidth="100.0" prefWidth="130.0" text="Type" />
                                                                        <TableColumn fx:id="accountTransactionAmountColumn" minWidth="100.0" prefWidth="130.0" text="Amount" />
                                                                        <TableColumn fx:id="accountTransactionCurrencyColumn" minWidth="80.0" prefWidth="100.0" text="Currency" />
                                                                        <TableColumn fx:id="accountTransactionSourceColumn" minWidth="140.0" prefWidth="180.0" text="Source Account" />
                                                                        <TableColumn fx:id="accountTransactionTargetColumn" minWidth="140.0" prefWidth="180.0" text="Target Account" />
                                                                        <TableColumn fx:id="accountTransactionNoteColumn" minWidth="180.0" prefWidth="280.0" text="Note" />
                                                                    </columns>
                                                                    <placeholder>
                                                                        <Label text="No transactions available." />
                                                                    </placeholder>
                                                                </TableView>
                                                            </children>
                                                        </StackPane>
                                                    </content>
                                                </Tab>
                                                <Tab text="TBD">
                                                    <content>
                                                        <StackPane styleClass="transactions-tab-content">
                                                            <children>
                                                                <Label styleClass="empty-state-label" text="TBD" />
                                                            </children>
                                                        </StackPane>
                                                    </content>
                                                </Tab>
                                            </tabs>
                                        </TabPane>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </items>
</SplitPane>
